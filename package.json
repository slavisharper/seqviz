{
  "name": "@slavisharper/seqviz",
  "description": "Forked seqviz package to support lab thread sequence viewer",
  "version": "1.0.83",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "typings": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "unpkg": "dist/seqviz.min.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true })\" && webpack",
    "prepack": "npm run build",
    "demo": "cd demo && npm run deploy",
    "fix": "prettier ./src/** --write && eslint src --ext ts,tsx --fix",
    "lint": "prettier ./src/** --check && eslint src --ext ts,tsx --quiet",
    "start": "cd demo && npm run start",
    "dev": "cd demo && npm install && npm run dev",
    "test": "CI=true jest"
  },
  "keywords": [
    "AA",
    "DNA",
    "RNA",
    "plasmid",
    "sequence",
    "seqviz",
    "vector",
    "viewer"
  ],
  "homepage": "https://github.com/slavisharper/seqviz",
  "bugs": {
    "url": "https://github.com/slavisharper/seqviz/issues",
    "email": "stsvetanov@labthread.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slavisharper/seqviz.git"
  },
  "license": "MIT",
  "author": "Lattice Automation (https://latticeautomation.com/) and contributors",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "browserslist": [
    ">1%",
    "not dead"
  ],
  "dependencies": {
    "react-resize-detector": "^12.3.0",
    "seqparse": "^0.2.1",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@eslint/eslintrc": "^3.1.0",
    "csstype": "^3.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "html-webpack-plugin": "^5.6.5",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "next": "^16.0.10",
    "path-browserify": "^1.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "source-map-loader": "^5.0.0",
    "stream-browserify": "^3.0.0",
    "timers-browserify": "^2.0.12",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-node-externals": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^16.8.6 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.6 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
