{
  "name": "@slavisharper/seqviz",
  "description": "Forked seqviz package to support lab thread visualization",
  "version": "1.0.5",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/seqviz.min.js",
  "scripts": {
    "build": "rm -rf ./dist && webpack",
    "demo": "cd demo && npm run deploy",
    "fix": "prettier ./src/** --write && eslint src --ext ts,tsx --fix",
    "lint": "prettier ./src/** --check && eslint src --ext ts,tsx --quiet",
    "start": "cd demo && npm run start",
    "dev": "cd demo && npm install && npm run dev",
    "test": "CI=true jest"
  },
  "keywords": [
    "AA",
    "DNA",
    "RNA",
    "plasmid",
    "sequence",
    "seqviz",
    "vector",
    "viewer"
  ],
  "homepage": "https://github.com/slavisharper/seqviz",
  "bugs": {
    "url": "https://github.com/slavisharper/seqviz/issues",
    "email": "stsvetanov@labthread.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slavisharper/seqviz.git"
  },
  "license": "MIT",
  "author": "Lattice Automation (https://latticeautomation.com/) and contributors",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "browserslist": [
    ">1%",
    "not dead"
  ],
  "dependencies": {
    "react-resize-detector": "^7.1.2",
    "seqparse": "^0.2.1",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.7",
    "@types/xml2js": "^0.4.9",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "csstype": "^3.2.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next": "^14.1.0",
    "path-browserify": "^1.0.1",
    "prettier": "^2.5.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "source-map-loader": "^1.1.3",
    "stream-browserify": "^3.0.0",
    "timers-browserify": "^2.0.12",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.73.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.9.3",
    "webpack-node-externals": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^16.8.6 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.6 || ^17.0.0 || ^18.0.0 || ^19.0.0"
